<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Diagnostico temporal: logback no imprime nada cuando un appender falla
         (p. ej. Logtail sin poder conectar) a menos que haya un statusListener.
         Se puede quitar una vez confirmado que Logtail conecta bien. -->
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Consola: siempre activa, útil para logs locales y capturados por Render/Railway -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Better Stack: solo activo en el perfil "production" -->
    <!-- Variables de entorno LOGTAIL_SOURCE_TOKEN y LOGTAIL_INGEST_HOST deben
         configurarse manualmente en Render/Railway al momento del despliegue.
         Ver DEVOPS-backend.md sección Logging. -->
    <springProfile name="production">
        <appender name="Logtail" class="com.logtail.logback.LogtailAppender">
            <appName>quantum-crm-backend</appName>
            <sourceToken>${LOGTAIL_SOURCE_TOKEN}</sourceToken>
            <ingestUrl>https://${LOGTAIL_INGEST_HOST}</ingestUrl>
            <mdcFields>traceId,usuario,modulo</mdcFields>
            <mdcTypes>string,string,string</mdcTypes>
        </appender>

        <root level="INFO">
            <appender-ref ref="Console"/>
            <appender-ref ref="Logtail"/>
        </root>
    </springProfile>

    <!-- Local/dev: solo consola -->
    <springProfile name="!production">
        <root level="INFO">
            <appender-ref ref="Console"/>
        </root>
    </springProfile>

</configuration>