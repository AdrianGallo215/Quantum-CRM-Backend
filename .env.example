# Quantum CRM Backend — variables de entorno (PLANTILLA)
# Copiar a `.env` y completar. NUNCA commitear el `.env` real (ver .gitignore).

# ── Base de datos (consumida por la app y por docker-compose) ──
DB_URL=jdbc:postgresql://localhost:5432/quantum_crm
DB_USERNAME=quantum
DB_PASSWORD=quantum_local
DB_PORT=5432

# Credenciales del contenedor PostgreSQL (docker-compose).
# Deben ser coherentes con DB_URL / DB_USERNAME / DB_PASSWORD.
POSTGRES_DB=quantum_crm
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum_local

# ── JWT ────────────────────────────────────────────────────
# Generar un secreto real con: openssl rand -hex 32
JWT_SECRET=reemplazar_por_secreto_de_256_bits
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Spring ─────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Google Drive (Headless Storage) ─────────────────────────
# El JSON del Service Account NUNCA se commitea ni se lee desde disco en
# runtime: se codifica entero en base64 (linea unica) y viaja por env.
#   base64 -w0 mi-service-account.json
GOOGLE_DRIVE_CREDENTIALS_BASE64=

# ID de la UNIDAD COMPARTIDA raiz (empieza en 0A, no en 1).
# IMPORTANTE: una carpeta de "Mi unidad" NO sirve. Las cuentas de servicio no
# tienen cuota y no pueden ser duenas de archivos: subir a Mi unidad falla con
# 403 storageQuotaExceeded. El Service Account debe ser Administrador de
# contenido de la unidad compartida.
ROOT_DRIVE_FOLDER_ID=

# Tamano de chunk del upload resumable. Acota la RAM por subida en curso.
# Debe ser multiplo de 262144 (256 KB). 5 MB por defecto.
DRIVE_UPLOAD_CHUNK_SIZE_BYTES=5242880
# Tope de tamano por archivo aceptado en el endpoint de subida (100 MB).
DRIVE_MAX_FILE_SIZE_BYTES=104857600
DRIVE_CONNECT_TIMEOUT_MS=10000
DRIVE_READ_TIMEOUT_MS=120000

# ── Logging tecnico (Better Stack / Logtail) ────────────────
# Solo se usan cuando SPRING_PROFILES_ACTIVE=production (ver logback-spring.xml).
# En local no hace falta completarlas: el perfil "local" nunca activa el
# appender de Logtail. Se obtienen del dashboard de Better Stack al crear
# la fuente de logs (Source) del proyecto.
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGEST_HOST=

# ── Tipo de cambio SUNAT (proveedor Decolecta) ──────────────
# API key de https://decolecta.com. Secreto: nunca se commitea con valor.
# Vacia => la integracion queda apagada y el CRM usa el ultimo tipo de cambio
# guardado en la tabla `tipo_cambio`.
DECOLECTA_API_KEY=
SUNAT_TIPO_CAMBIO_URL=https://api.decolecta.com/v1/tipo-cambio/sunat
SUNAT_TIMEOUT_SEGUNDOS=10
